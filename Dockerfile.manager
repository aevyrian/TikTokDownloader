FROM python:3.12-slim
WORKDIR /app
COPY requirements-manager.txt ./
RUN pip install --no-cache-dir -r requirements-manager.txt && useradd --uid 10001 --create-home downloader
COPY src ./src
COPY locale ./locale
COPY manager ./manager
COPY license ./license
RUN mkdir -p /data /app/Volume && chown -R downloader:downloader /data /app/Volume
USER downloader
ENV DOUYIN_DATA=/data DOUYIN_HOST=0.0.0.0 DOUYIN_PORT=8787 PYTHONUNBUFFERED=1
VOLUME ["/data"]
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8787/health', timeout=3)"
CMD ["python", "-m", "manager"]
