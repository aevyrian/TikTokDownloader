{
  "manifest_version": 3,
  "name": "抖音下载助手",
  "version": "0.1.0",
  "description": "将当前抖音作品或页面链接提交到个人下载管理器",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {"default_popup": "popup.html", "default_title": "抖音下载助手"}
}
